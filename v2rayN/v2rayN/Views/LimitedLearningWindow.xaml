<Window x:Class="v2rayN.Views.LimitedLearningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规则管理与自动分流" Width="1080" Height="820" MinWidth="960" MinHeight="740"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="规则管理">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="规则与出口"/>
                        <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" Text="按列表从上到下匹配，命中后停止。受保护程序直连 → 手动规则 → 内置 AI → 原路由规则 → 自动学习。支持标准 Xray 系统代理与原生 TUN。TUN 接管 DNS 和浏览器 UDP；系统代理需配合“浏览器防泄露”设置。"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="默认代理节点"/><ComboBox x:Name="DefaultPolicyNode" HorizontalAlignment="Stretch" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="专线节点（手动专线、内置 AI 和社区代理名单共用）"/><ComboBox x:Name="AiPolicyNode" HorizontalAlignment="Stretch" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <CheckBox x:Name="EnableCommunityPolicy" Margin="0,10,0,4" Content="社区代理名单走专线；大陆及局域网直连；其余按自动分流设置处理"/>
                        <CheckBox x:Name="EnableAiPolicy" Margin="0,10,0,4" Content="启用内置 AI 网站规则，未命中手动规则的 AI 网站走专线"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="关闭内置 AI 不影响手动专线规则。主窗口切换节点只改变默认代理。修改仅在保存后生效。"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,14,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Margin="0,0,16,0">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="RuleEditorTitle" FontWeight="SemiBold" Text="新增规则"/>
                                <TextBlock Margin="0,10,0,4" Text="规则类型"/>
                                <ComboBox x:Name="RuleKind" HorizontalAlignment="Stretch" SelectionChanged="RuleKind_SelectionChanged"/>
                                <TextBlock Margin="0,10,0,4" Text="匹配内容"/>
                                <TextBox x:Name="RuleValue"/>
                                <TextBlock x:Name="RuleHint" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,10,0,4" Text="出口策略"/>
                                <ComboBox x:Name="RuleTarget" HorizontalAlignment="Stretch"/>
                                <TextBlock Margin="0,10,0,4" Text="备注（可选）"/>
                                <TextBox x:Name="RuleRemarks"/>
                                <CheckBox x:Name="RuleEnabled" Content="启用这条规则" IsChecked="True" Margin="0,10,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button x:Name="ApplyRuleButton" Content="添加到顶部" Click="ApplyRule_Click" Margin="0,0,8,6"/>
                                <Button Content="清空 / 新建" Click="NewRule_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="RuleCount" Margin="0,0,0,8" Text="手动规则"/>
                            <DataGrid x:Name="ManualRulesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="70"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding KindLabel}" Width="130"/>
                                    <DataGridTextColumn Header="匹配内容" Binding="{Binding Value}" Width="*"/>
                                    <DataGridTextColumn Header="出口" Binding="{Binding TargetLabel}" Width="105"/>
                                    <DataGridTextColumn Header="备注" Binding="{Binding Remarks}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                <Button Content="编辑" Click="EditRule_Click" Margin="0,0,8,6"/>
                                <Button Content="启用 / 停用" Click="ToggleRule_Click" Margin="0,0,8,6"/>
                                <Button Content="上移" Click="MoveRuleUp_Click" Margin="0,0,8,6"/>
                                <Button Content="下移" Click="MoveRuleDown_Click" Margin="0,0,8,6"/>
                                <Button Content="删除" Click="DeleteRule_Click" Margin="0,0,8,6"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                    <Expander Grid.Row="2" Header="受保护程序直连与内置 AI 范围">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,0,4">
                                <TextBlock TextWrapping="Wrap" Text="受保护程序优先于所有网站规则。每行填一个不含 .exe 的进程名，或使用 / 分隔且以 / 结尾的绝对目录。仅匹配进入代理且内核能识别的连接。"/>
                                <TextBox x:Name="DirectProcesses" Margin="0,6,0,8" Height="85" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="AiCatalogState" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap" Text="内置 AI 分类随 Geo 数据更新；原路由规则仍在“设置 → 路由设置”中维护。手动规则独立保存，不随订阅更新覆盖。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="仅修改规则会热更新：已有连接保持原出口，新连接按新规则走。切换节点需要重启，请使用单独按钮。"/>
                        <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="SaveNodesButton" Content="应用节点变更并重启" IsEnabled="False" Margin="0,0,12,0" Padding="14,8" Click="SaveNodes_Click"/>
                            <Button x:Name="SavePoliciesButton" Content="保存规则（不中断连接）" IsEnabled="False" Padding="18,8" Click="SavePolicies_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="自动分流">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="未匹配网站处理" />
                        <TextBlock Margin="0,10,0,18" TextWrapping="Wrap"
                                   Text="未匹配现有规则的网站先检测直连；直连失败后检测代理。代理检测成功后，保存该主机名的代理记录。累计 5 次独立确认后转为永久记录；有效期内的重复访问不计数。"/>
                        <CheckBox x:Name="EnableLearning" Content="启用未知网站直连探测与代理记录（成功后正式请求也直连）"/>
                        <TextBlock Margin="0,12,0,16" TextWrapping="Wrap" Foreground="DimGray"
                                   Text="支持标准 Xray 系统代理与原生 TUN，仅检测 TCP 80/443。探测不携带登录凭据，但会暴露本地出口；成功后正式请求也直连。DNS 经默认代理解析。"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="直连检测限时（毫秒）"/><TextBox x:Name="DirectTimeout" Margin="0,8,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="代理检测限时（毫秒）"/><TextBox x:Name="ProxyTimeout" Margin="0,8,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="临时记录有效期（小时）"/><TextBox x:Name="Lifetime" Margin="0,8,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Margin="0,16,0,8" Text="强制直连程序已移至“规则管理”页。"/>
                        <TextBlock x:Name="LearningState" TextWrapping="Wrap" Foreground="DimGray"/>
                        <Button Margin="0,16,0,0" HorizontalAlignment="Left" Padding="18,8" Content="保存并重载规则" Click="SaveLearning_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="学习记录">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Text="记录归默认策略，仅用于未匹配现有规则的网站，按主机名、端口和默认节点分别累计。临时记录到期后保留次数并重新检测；达到 5 次后永久代理。删除记录会清零次数。"/>
                    <DataGrid x:Name="Records" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="主机名" Binding="{Binding Host}" Width="*"/>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="55"/>
                            <DataGridTextColumn Header="确认次数" Binding="{Binding ConfirmationDisplay}" Width="75"/>
                            <DataGridTextColumn Header="有效期" Binding="{Binding ExpiryDisplay}" Width="175"/>
                            <DataGridTextColumn Header="检测依据" Binding="{Binding Reason}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="刷新" Click="RefreshRecords_Click" Margin="0,0,12,0"/>
                        <Button Content="删除记录并清零次数" Click="ForgetRecord_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="浏览器防泄露">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="20" Text="Chrome / Edge 网络防护"/>
                        <TextBlock Margin="0,12,0,12" TextWrapping="Wrap" Text="TUN：DNS 接管与 IPv6 路由由 Xray 处理，浏览器 UDP 经代理转发。配套策略限制接口地址暴露，保留 UDP 通话。系统代理：限制未代理的 WebRTC UDP，网页通话需要支持 TCP 中继。"/>
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Text="按钮按当前 TUN 开关应用当前用户的 Chrome/Edge 策略，并保存备份；不会修改节点选择。策略需要完全退出浏览器后重开，并在 chrome://policy 或 edge://policy 确认生效。切换模式后请先恢复，再重新应用。"/>
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Text="系统代理只管理进入代理的连接，不能接管全部系统 DNS 或所有应用 UDP。通话是否可用还取决于节点 UDP 支持、TURN 中继及浏览器策略；不要把检测超时当作无泄露。"/>
                        <WrapPanel>
                            <Button Content="按当前模式应用浏览器防护" Click="ApplyBrowserPrivacy_Click" Margin="0,0,12,8"/>
                            <Button Content="恢复浏览器原设置" Click="RestoreBrowserPrivacy_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="BrowserPrivacyResult" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Codex 系统代理">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Codex 连接设置"/>
                        <TextBlock Margin="0,10,0,12" TextWrapping="Wrap" Text="启用 Codex 的 Windows 系统代理支持，并检测 WebSocket 连接。OpenAI 域名的分流由现有规则决定。"/>
                        <TextBlock x:Name="SystemProxyState" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="Codex 配置目录"/><TextBox x:Name="CodexHome" Margin="0,5,0,12"/>
                        <TextBlock Text="Codex 程序路径"/>
                        <DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择…" Click="BrowseCodex_Click"/><TextBox x:Name="CodexExecutable"/></DockPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="启用系统代理支持" Click="EnableCodex_Click" Margin="0,0,12,8"/>
                            <Button Content="恢复原配置" Click="UndoCodex_Click" Margin="0,0,12,8"/>
                            <Button x:Name="DiagnoseButton" Content="检测 WebSocket 握手" Click="DiagnoseCodex_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="DimGray" Text="启用前会备份 Codex 配置。请在主窗口选择“自动配置系统代理”，修改后完全退出并重启 Codex。验证系统代理连接时需关闭 TUN。"/>
                        <TextBox x:Name="CodexResult" Margin="0,12,0,0" Height="250" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="1" x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
