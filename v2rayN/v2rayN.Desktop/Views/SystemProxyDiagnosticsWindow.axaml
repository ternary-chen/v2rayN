<Window x:Class="v2rayN.Desktop.Views.SystemProxyDiagnosticsWindow"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="系统代理检查" Width="900" Height="680" MinWidth="720" MinHeight="480"
 WindowStartupLocation="CenterOwner" x:CompileBindings="False">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="检查当前系统代理设置" FontSize="20" FontWeight="SemiBold"/>
  <StackPanel Grid.Row="1" Margin="0,12,0,12">
   <TextBlock Text="先在主窗口执行代理操作，再选择对应检查。检查本身不会修改代理，也不需要联网。" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
    <Button x:Name="InspectButton" Content="查看当前状态" Margin="0,0,8,0" Padding="12,6"/>
    <Button x:Name="ClearCheckButton" Content="验证已清除" Margin="0,0,8,0" Padding="12,6"/>
    <Button x:Name="ProxyCheckButton" Content="验证自动配置" Padding="12,6"/>
   </StackPanel>
   <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontWeight="SemiBold"/>
  </StackPanel>
  <TextBox x:Name="ReportBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="10"/>
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="SaveReportButton" Content="保存本次报告" Margin="0,0,8,0" Padding="12,6"/>
    <Button x:Name="CloseButton" Content="关闭" Padding="12,6"/>
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>
